<odoo>
    <record id="documenso_signature_request_user_group" model="res.groups">
        <field name="name">Signature Request User</field>
        <field name="category_id" ref="ssi_connector.connector_module_category" />
    </record>

    <!-- Keep today's access unchanged: every internal user still gets the
         new group, so the wizard ACL below does not lock anyone out. -->
    <record id="base.group_user" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('documenso_signature_request_user_group'))]"
        />
    </record>

    <record id="documenso_signing_template_group" model="res.groups">
        <field name="name">Documenso Signing Template Configurator</field>
        <field name="category_id" ref="ssi_connector.connector_module_category" />
    </record>

    <!-- Keep today's access unchanged: every connector manager still gets
         the new configurator group, mirroring the pattern above. -->
    <record id="connector.group_connector_manager" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('documenso_signing_template_group'))]"
        />
    </record>
</odoo>
