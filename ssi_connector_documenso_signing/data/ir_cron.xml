<odoo>
    <record id="ir_cron_documenso_update_signature_status" model="ir.cron">
        <field name="name">Documenso: Update Signature Status</field>
        <field name="model_id" ref="model_documenso_signature_request" />
        <field name="state">code</field>
        <field name="code">model.cron_update_signature_status()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True" />
        <field name="doall" eval="False" />
    </record>
</odoo>
