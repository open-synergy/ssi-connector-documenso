<odoo>
    <!-- ============================================================= -->
    <!--  documenso.signing.template – Search View                      -->
    <!-- ============================================================= -->
    <record id="documenso_signing_template_view_search" model="ir.ui.view">
        <field name="name">documenso.signing.template - search</field>
        <field name="model">documenso.signing.template</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <!-- ============================================================= -->
    <!--  documenso.signing.template – Tree View                        -->
    <!-- ============================================================= -->
    <record id="documenso_signing_template_view_tree" model="ir.ui.view">
        <field name="name">documenso.signing.template - tree</field>
        <field name="model">documenso.signing.template</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="res_model" />
                    <field name="py3o_report_id" />
                </xpath>
            </data>
        </field>
    </record>

    <!-- ============================================================= -->
    <!--  documenso.signing.template – Form View                        -->
    <!-- ============================================================= -->
    <record id="documenso_signing_template_view_form" model="ir.ui.view">
        <field name="name">documenso.signing.template - form</field>
        <field name="model">documenso.signing.template</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook/page[@name='note']" position="before">
                    <page name="document" string="Document">
                        <group name="document_group_1" string="Document">
                            <field name="res_model" />
                            <field name="allowed_py3o_report_ids" invisible="1" />
                            <field
                                name="py3o_report_id"
                                domain="[('id', 'in', allowed_py3o_report_ids)]"
                            />
                        </group>
                    </page>
                    <page name="signer_templates" string="Signer Templates">
                        <field name="signer_template_ids">
                            <tree>
                                <field name="signing_order" />
                                <field name="role" />
                                <field name="signature_anchor" />
                                <field name="signature_width" />
                                <field name="signature_height" />
                                <field name="partner_code" />
                            </tree>
                            <form>
                                <group>
                                    <group>
                                        <field name="signing_order" />
                                        <field name="role" />
                                        <field name="signature_anchor" />
                                        <field name="signature_width" />
                                        <field name="signature_height" />
                                    </group>
                                </group>
                                <group string="Partner Python Code">
                                    <field
                                        name="partner_code"
                                        widget="ace"
                                        options="{'mode': 'python'}"
                                        nolabel="1"
                                    />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <!-- ============================================================= -->
    <!--  Window Action                                                  -->
    <!-- ============================================================= -->
    <record id="action_documenso_signing_template" model="ir.actions.act_window">
        <field name="name">Signing Templates</field>
        <field name="res_model">documenso.signing.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
