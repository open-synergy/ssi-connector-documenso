<odoo>
    <!-- ============================================================= -->
    <!--  documenso.signature.request – Form View                       -->
    <!-- ============================================================= -->
    <record id="view_documenso_signature_request_form" model="ir.ui.view">
        <field name="name">documenso.signature.request.form</field>
        <field name="model">documenso.signature.request</field>
        <field name="arch" type="xml">
            <form string="Signature Request">
                <header>
                    <button
                        name="action_generate_pdf"
                        string="Generate PDF"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_send_to_documenso"
                        string="Send to Documenso"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                        confirm="This will generate the PDF and send it to Documenso for signing. Continue?"
                    />
                    <button
                        name="action_check_status"
                        string="Check Status"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'sent')]}"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', 'not in', ['draft', 'sent'])]}"
                    />
                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'cancelled')]}"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,sent,signed"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="res_name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Template">
                            <field name="signing_template_id" />
                        </group>
                    </group>
                    <group>
                        <group string="Document">
                            <field name="backend_id" />
                            <field name="res_model" />
                            <field name="res_id" />
                            <field name="allowed_py3o_report_ids" invisible="1" />
                            <field
                                name="py3o_report_id"
                                domain="[('id', 'in', allowed_py3o_report_ids)]"
                            />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group string="Documenso">
                            <field name="documenso_document_id" />
                            <field name="pdf_file" filename="pdf_filename" />
                            <field name="pdf_filename" invisible="1" />
                            <field
                                name="signed_pdf_file"
                                filename="signed_pdf_filename"
                            />
                            <field name="signed_pdf_filename" invisible="1" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Signers" name="signers">
                            <field name="signer_ids">
                                <tree editable="bottom">
                                    <field name="signing_order" />
                                    <field name="partner_id" />
                                    <field name="partner_email" />
                                    <field name="role" />
                                    <field name="signature_anchor" />
                                    <field name="signature_width" />
                                    <field name="signature_height" />
                                    <field name="signing_status" />
                                    <field name="documenso_recipient_id" readonly="1" />
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes…" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================= -->
    <!--  documenso.signature.request – Tree View                       -->
    <!-- ============================================================= -->
    <record id="view_documenso_signature_request_tree" model="ir.ui.view">
        <field name="name">documenso.signature.request.tree</field>
        <field name="model">documenso.signature.request</field>
        <field name="arch" type="xml">
            <tree
                string="Signature Requests"
                decoration-info="state == 'draft'"
                decoration-warning="state == 'sent'"
                decoration-success="state == 'signed'"
                decoration-muted="state == 'cancelled'"
            >
                <field name="res_name" />
                <field name="res_model" />
                <field name="backend_id" />
                <field name="py3o_report_id" />
                <field name="signer_count" />
                <field name="documenso_document_id" />
                <field name="state" />
                <field name="create_date" />
            </tree>
        </field>
    </record>

    <!-- ============================================================= -->
    <!--  documenso.signature.request – Search View                     -->
    <!-- ============================================================= -->
    <record id="view_documenso_signature_request_search" model="ir.ui.view">
        <field name="name">documenso.signature.request.search</field>
        <field name="model">documenso.signature.request</field>
        <field name="arch" type="xml">
            <search string="Signature Requests">
                <field name="res_name" />
                <field name="res_model" />
                <field name="backend_id" />
                <field name="documenso_document_id" />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_sent"
                    string="Sent"
                    domain="[('state', '=', 'sent')]"
                />
                <filter
                    name="filter_signed"
                    string="Signed"
                    domain="[('state', '=', 'signed')]"
                />
                <filter
                    name="filter_cancelled"
                    string="Cancelled"
                    domain="[('state', '=', 'cancelled')]"
                />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_backend"
                        string="Backend"
                        context="{'group_by': 'backend_id'}"
                    />
                    <filter
                        name="group_model"
                        string="Source Model"
                        context="{'group_by': 'res_model'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================= -->
    <!--  Action                                                        -->
    <!-- ============================================================= -->
    <record id="action_documenso_signature_request" model="ir.actions.act_window">
        <field name="name">Signature Requests</field>
        <field name="res_model">documenso.signature.request</field>
        <field name="view_mode">tree,form</field>
        <field
            name="context"
        >{'search_default_filter_draft': 1, 'search_default_filter_sent': 1}</field>
    </record>
</odoo>
