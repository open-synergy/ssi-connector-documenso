<odoo>
    <record id="create_documenso_signature_request_view_form" model="ir.ui.view">
        <field name="name">create_documenso_signature_request form</field>
        <field name="model">create_documenso_signature_request</field>
        <field name="arch" type="xml">
            <form string="Create Signing Request">
                <group>
                    <field name="res_model" invisible="1" />
                    <field name="res_id" invisible="1" />
                    <field name="signing_template_id" />
                    <field name="backend_id" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Create"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Discard" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="create_documenso_signature_request_action"
        model="ir.actions.act_window"
    >
        <field name="name">Create Signing Request</field>
        <field name="res_model">create_documenso_signature_request</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
