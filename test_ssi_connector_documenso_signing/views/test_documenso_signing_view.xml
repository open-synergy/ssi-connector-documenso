<odoo>
    <record id="test_documenso_signing_view_tree" model="ir.ui.view">
        <field name="name">test.documenso_signing.tree</field>
        <field name="model">test.documenso_signing</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="test_documenso_signing_view_form" model="ir.ui.view">
        <field name="name">test.documenso_signing.form</field>
        <field name="model">test.documenso_signing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="signature_request_count" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>
</odoo>
