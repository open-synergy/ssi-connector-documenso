<odoo>
    <!-- Backend form view -->
    <record id="view_documenso_backend_form" model="ir.ui.view">
        <field name="name">documenso.backend.form</field>
        <field name="model">documenso.backend</field>
        <field name="arch" type="xml">
            <form string="Documenso Backend">
                <header>
                    <button
                        name="action_test_connection"
                        string="Test Connection"
                        type="object"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="Backend Name" /></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field
                                name="base_url"
                                placeholder="https://app.documenso.com"
                            />
                            <field name="api_key" password="True" />
                            <field name="version" />
                        </group>
                        <group string="General">
                            <field name="company_id" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Backend list/tree view -->
    <record id="view_documenso_backend_tree" model="ir.ui.view">
        <field name="name">documenso.backend.tree</field>
        <field name="model">documenso.backend</field>
        <field name="arch" type="xml">
            <tree string="Documenso Backends">
                <field name="name" />
                <field name="base_url" />
                <field name="version" />
                <field name="company_id" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- Backend search view. documenso.backend does not use
         ssi_master_data_mixin (it inherits connector.backend), so this is a
         standalone minimal search view rather than an inherit of
         mixin_master_data_view_search, kept narrow to only what the
         Archived filter needs (name search field + inactive filter). Without
         this view, ir.ui.view._get_default_search_view() falls back to a
         bare id/display_name search box with no filter at all, so the
         Archived filter used by docs/documenso_backend/05-activate.md never
         appears in the UI. -->
    <record id="view_documenso_backend_search" model="ir.ui.view">
        <field name="name">documenso.backend.search</field>
        <field name="model">documenso.backend</field>
        <field name="arch" type="xml">
            <search string="Documenso Backends">
                <field name="name" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <!-- Backend action -->
    <record id="action_documenso_backend" model="ir.actions.act_window">
        <field name="name">Documenso Backends</field>
        <field name="res_model">documenso.backend</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_documenso_backend"
        name="Backends"
        parent="menu_documenso_configuration"
        action="action_documenso_backend"
        groups="connector.group_connector_manager"
        sequence="10"
    />
</odoo>
